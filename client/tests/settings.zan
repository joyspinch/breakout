using System;
using Game.Foundation;

// 设置基座的项目侧断言：
//   - 默认值来自声明；
//   - 非候选档位的写入被忽略（基座负责，游戏侧不该崩也不该写坏配置）；
//   - 设置真的落盘（test.ps1 跑两遍：首跑写、次跑读回）。
public class BkSettingsCheck {
    static void Main() {
        BkSettings.Ensure();
        Console.WriteLine("speed=" + Convert.ToString(BkSettings.BallSpeedPct()));
        BkSettings.SetBallSpeedPct(120);
        BkSettings.SetBallSpeedPct(999);   // 不在声明档位里：必须被忽略，仍是 120
        Console.WriteLine("after=" + Convert.ToString(BkSettings.BallSpeedPct()));
        Console.WriteLine("settings OK");
    }
}
